DROP TABLE IF EXISTS compagnies, divisions, departments, users, items, itemoperations;


CREATE TABLE users (
  id INT AUTO_INCREMENT PRIMARY KEY,
  username VARCHAR(50),
  password VARCHAR(64),
  langage VARCHAR(2),
  timezone VARCHAR(2),
  display VARCHAR(25),
  sorting VARCHAR(250),
  role VARCHAR(25),
  department VARCHAR(7)
);

CREATE TABLE departments (
  id INT AUTO_INCREMENT PRIMARY KEY,
  cono VARCHAR(3),
  divi VARCHAR(3)
);


CREATE TABLE items (
  id INT AUTO_INCREMENT PRIMARY KEY,
  reference VARCHAR(25),
  colour VARCHAR(250) NOT NULL,
  size VARCHAR(250) NOT NULL,
  sizenumber INT NOT NULL,
  graphics VARCHAR(250) NOT NULL,
  price DECIMAL(4, 2) NOT NULL,
  table_row INT NOT NULL,
  department VARCHAR(7)
);


CREATE TABLE itemoperations (
  id INT AUTO_INCREMENT  PRIMARY KEY,
  dateop VARCHAR(25) NOT NULL,
  reference VARCHAR(25) NOT NULL,
  operation VARCHAR(25) NOT NULL,
  description VARCHAR(250) NOT NULL,
  department VARCHAR(7)
);


