	/** init **/ 
	//launch the application
	@GetMapping("/")
    public String init(Model model) throws FileNotFoundException, IOException {
		
		//check if connection
		if(!contextService.checkConnection()) {
			return "redirect:/login";
		}
		
		//get Locale
		String lang = contextService.getUserContext().getLangage();
		
		return "redirect:/initLocale" + "?lang=" + lang;
	}

	/** Locale **/ 
	//init Locale
	@GetMapping("/initLocale")
	public String initLocale(Model model) {
		return "redirect:/menu";
	}
				
	//update Locale
	@GetMapping("/updateLocale")
	public String updateLocale(@RequestParam("transaction") Optional<String> transaction, Model model) {
		
		if(!transaction.isPresent()) {
			return "redirect:/menu";
		}
		
		return "redirect:/" + transaction.orElse("") + "/board";
	}
		
	@GetMapping("/initLangage")
	public String initLangage(StringObject table, BindingResult result, Model model)
	    	throws FileNotFoundException, IOException, NoSuchAlgorithmException, ParseException {
			
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
					
		//manage flag of userContext
		if(contextService.getUserContext().isToflag()) {
			contextService.getUserContext().setFlag(true);
			contextService.getUserContext().setToflag(false);
		}
		else {
			contextService.getUserContext().setFlag(false);
		}
					
		//get userContext
		UserContext userContext = contextService.getUserContext();
					
		//add model in page
		model.addAttribute("userContext", userContext);
					
		return "initLangage";
				
	}

	@GetMapping("/langage")
	public String langage(Model model) throws IOException, ParseException {
			
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
			
		//manage flag of userContext
		if(contextService.getUserContext().isToflag()) {
			contextService.getUserContext().setFlag(true);
			contextService.getUserContext().setToflag(false);
		}
		else {
			contextService.getUserContext().setFlag(false);
		}
			
		//get userContext
		UserContext userContext = contextService.getUserContext();
			
		//add model in page
		model.addAttribute("userContext", userContext);
			
		return "langage";
		
	}
		
	@PostMapping("/updatelangage")
	public String updatelangage(@RequestParam("transaction") Optional<String> transaction, UserContext userContext, 
	    	BindingResult result, Model model) throws IOException, ParseException {
			
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
			
		//get language and time zone of user
		String lang = userContext.getLangage();
		String timezone = userContext.getTimezone() == null ? "EN" : userContext.getTimezone();
			
		//set language and time zone in user context
		contextService.getUserContext().setLangage(lang);
		contextService.getUserContext().setTimezone(timezone);
			
		//manage flag of userContext
		if(userContext.isFlag()) {
			contextService.getUserContext().setToflag(false);
		}
			
		if(!transaction.isPresent()) {
			return "redirect:/updateLocale" + "?lang=" + lang;
		}
		else {
			return "redirect:/updateLocale" + "?lang=" + lang + "&transaction=" + transaction.orElse("");
		}
		
	}
		
	/** Department **/	
	@GetMapping("/initDepartment")
	public String initdepartment(Model model) {
			
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
			
		//create department
		User user = userService.pickUpUser(contextService.getSessionContext().getUserId());
		String userDepartment = user.getDepartment();
		Department department = new Department(userDepartment.split("/")[0], userDepartment.split("/")[1]);
		
		//get errorMsg
		String error = msgErrorService.getErrorMsg();
				
		//add department and error in page
		model.addAttribute("department", department);
		model.addAttribute("error", error);
			
		return "initDepartment";
			
	}
		
	@GetMapping("/department")
	public String department(Model model) {
			
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
			
		//create department
		User user = userService.pickUpUser(contextService.getSessionContext().getUserId());
		String userDepartment = user.getDepartment();
		Department department = new Department(userDepartment.split("/")[0], userDepartment.split("/")[1]);
			
		//get errorMsg
		String error = msgErrorService.getErrorMsg();
			
		//add department and error in page
		model.addAttribute("department", department);
		model.addAttribute("error", error);
			
		return "department";
			
	}
		
	@PostMapping("/updateDepartment")
	public String updateDepartment(@RequestParam("transaction") Optional<String> transaction, Department department, 
			BindingResult result, Model model) throws FileNotFoundException, IOException, ParseException {
			
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
			
		//check if department exists
		if(msgErrorService.checkDepartment(department)) {
			if(!transaction.isPresent()) {
				return "redirect:/initDepartment";
			}
			else {
				return "redirect:/department";
			}
		}
			
		//get user
		int id = contextService.getSessionContext().getUserId();
		User user = userService.pickUpUser(id);
		
		//get department string
		String departmentStr = department.getCono() + "/" + department.getDivi();
			
		//check if change in department
		if(user.getDepartment().equals(departmentStr)) {
			if(!transaction.isPresent()) {
				return "redirect:/menu";
			}
			
			return "redirect:/" + transaction.orElse("") + "/board";	
		}
			
		//set new department in user and user context
		user.setDepartment(departmentStr);
		contextService.getUserContext().setDepartment(user.getDepartment());
			
		//save the user
		userService.saveUser(user);
			
		if(!transaction.isPresent()) {
			return "redirect:/menu";
		}
			
		return "redirect:/" + transaction.orElse("") + "/board";
			
	}
		
	/** Login **/	
	@GetMapping("/login")
    public String login(User user, BindingResult result, Model model) throws NoSuchAlgorithmException {
		
		//get user model and error message
		user.setUsername(msgErrorService.getMapUser().get("username"));
		String error = msgErrorService.getErrorMsg();
		
		//add user and error message in page
		model.addAttribute("user", user);
		model.addAttribute("error", error);
		
		//reset error message and user context
		msgErrorService.setUserError("", "", "", "", "");
		
        return "login/login";
    }

	@PostMapping("/connect")
    public String connect(User user, BindingResult result, Model model) throws NoSuchAlgorithmException {
		
		//check if error
		if(msgErrorService.checkLoginError(user)) {
			return "redirect:/login";
		}
		
		//get user's id and session's code
		int idUser = userService.pickUpUser(user.getUsername()).getId();
		String code = RequestContextHolder.currentRequestAttributes().getSessionId();
		
		//set beans userContext and sessionContext
		contextService.setUserContext(idUser);
		contextService.setSessionContext(idUser, user.getUsername(), code);
		contextService.getSessionContext().setRole("user");
		
		//reset error message and user context
		msgErrorService.setUserError("", "", "", "", "");
		
        return "redirect:/";
    }
	
	@GetMapping("/logout")
    public String logout(Model model) throws NoSuchAlgorithmException {
		
		//empty the session bean
		contextService.setSessionContext(0, "", "");
		
        return "redirect:/login";
    }
	
	@GetMapping("/check")
    public String check(Model model) {
		
		//get the user
		String username = msgErrorService.getMapUser().get("username");
		User user = new User(0, username, "");
		
		//get error message
		String error = msgErrorService.getErrorMsg();
		
		//add user and error message in page
		model.addAttribute("user", user);
		model.addAttribute("error", error);
		
		//reset error context
		msgErrorService.setUserError("", "", "", "", "");
		
        return "login/checkPass";
    }
	
	@PostMapping("/checkuser")
    public String checkuser(User user1, BindingResult result, Model model) throws NoSuchAlgorithmException {
		
		//get the user
		User user2 = userService.pickUpUser(user1.getUsername());
		
		//check if error
		if(msgErrorService.checkingUserError(user1, user2)) {
			return "redirect:/check";
		}
		
		//set session context bean
		String code = RequestContextHolder.currentRequestAttributes().getSessionId();
		contextService.setSessionContext(user2.getId(), user2.getUsername(), code);
		contextService.getSessionContext().setRole("user");
		
		//reset error context
		msgErrorService.setUserError("", "", "", "", "");
		
        return "redirect:/reset";
    }
	
	@GetMapping("/reset")
    public String reset(Model model) throws NoSuchAlgorithmException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//get reset model
		String username = contextService.getSessionContext().getUsername();
		Reset reset = new Reset(username, "", "");
		
		//get error message
		String error = msgErrorService.getErrorMsg();
		
		//add reset model and error message in page
		model.addAttribute("reset", reset);
		model.addAttribute("error", error);
		
        return "login/resetPass";
    }
	
	@PostMapping("/resetpassword")
    public String resetpassword(Reset reset, BindingResult result, Model model) throws NoSuchAlgorithmException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
				
		//check if error
		if(msgErrorService.resetPasswordError(reset) ){
			return "redirect:/reset";
		}
		
		//encrypt password
		String password = SecurityConfig.getEncryption(reset.getPass1());

		//set password in user
		User user = userService.pickUpUser(contextService.getSessionContext().getUsername());
		user.setPassword(password);
		
		//save user
		userService.saveUser(user);
		
		//reset error message and user context
		msgErrorService.setUserError("", "", "", "", "");
		
        return "redirect:/resetConf";
    }
	
	@GetMapping("/resetConf")
	public String resetconf() {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		return "login/confPass";
		
	}
	
	/** menu **/
	@GetMapping("/menu")
    public String menu(Model model) 
    		throws FileNotFoundException, IOException, NoSuchAlgorithmException, ParseException, java.text.ParseException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//get userContext, table
		//get time (belong time zone)
		//get error message
		UserContext userContext = contextService.getUserContext();
		StringObject table = new StringObject();
		String time = contextService.getTime(userContext.getTimezone());
		String error = msgErrorService.getErrorMsg();
		
		//add models in page
		model.addAttribute("userContext", userContext);
		model.addAttribute("table", table);
		model.addAttribute("time", time);
		model.addAttribute("error", error);
		
		msgErrorService.setMsgErrorContext("");
	
		return "menu";
		
    }
	
	@PostMapping("/chooseTable")
    public String chooseTable(StringObject table, BindingResult result, Model model)
    		throws FileNotFoundException, IOException, NoSuchAlgorithmException, ParseException {
		
		//get code
		String code = table.getText().toUpperCase();
		
		//redirect belong code
		switch (code){
			case "ITM100" :
				return "redirect:/Item100/init";
			default:
				if(!table.getText().isBlank()) {
					msgErrorService.msgMenuError(table.getText());
				}
				return "redirect:/menu";
		}
			
    }
	
