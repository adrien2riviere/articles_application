	public Iterable<String> getCompagnies() {
		Iterable<Department> departments = departmentRepository.findAll();
		List<String> compagnies = new ArrayList<String>();
		for(Department department : departments) {
			if(!compagnies.contains(department.getCono())) {
				compagnies.add(department.getCono());
			}
		}
		Iterable<String> iterable = compagnies;
		return iterable;
	}

	public Iterable<String> getDivisions(String cono) {
		
		Iterable<Department> departments = departmentRepository.findAll();
		List<String> divisions = new ArrayList<String>();
		for(Department department : departments) {
			if(cono.equals(department.getCono())) {
				divisions.add(department.getDivi());
			}
		}
		Iterable<String> iterable = divisions;
		return iterable;
	}	
	
	
	public boolean getConoMsg(String cono) {
		
		Iterable<Department> departments = getDepartments();
		
		for(Department department : departments) {
			if(cono.equals(department.getCono())) {
				return true;
			}
		}
		
		return false;
	}
	
	public boolean getDiviMsg(String cono, String divi) {
		
		Iterable<Department> departments = getDepartments();
		
		for(Department department : departments) {
			if(cono.equals(department.getCono())) {
				if(divi.equals(department.getDivi())) {
					return true;
				}
			}
		}
		
		return false;
	}

}
