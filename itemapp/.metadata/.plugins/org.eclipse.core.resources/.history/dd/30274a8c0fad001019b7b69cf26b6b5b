	@GetMapping("/admin/user/update/{id}")
    public String adminuserupdate(@PathVariable("id") int id, Model model) 
    		throws IOException, ParseException, java.text.ParseException, NoSuchAlgorithmException {
		
		//check if connection
		if(!contextService.admCheckConnection()) {
			return "redirect:/admin/adminconnectError";
		}
		
		//check if user exists
		if(!userService.getUser(id).isPresent()) {
			return "redirect:/admin/urlError/update/" + String.valueOf(id);
		}
		
		//get user
		User user = userService.pickUpUser(id);
		user.setPassword("");
		
		//get error message
		String error = msgErrorService.getMsgErrorContext().getErrorMsg();
		
		//add models in page
		model.addAttribute(user);
		model.addAttribute("error", error);
		
		//reset error context
		msgErrorService.setUserError("", "", "", "", "", "", "", "");
		
		return "admin/admupdate";
    }
	
	@PostMapping("/admin/user/updateuser")
    public String adminupdateuser(User user, BindingResult result, Model model) 
    		throws IOException, ParseException, java.text.ParseException, NoSuchAlgorithmException {
		
		//check if connection
		if(!contextService.admCheckConnection()) {
			return "redirect:/admin/adminconnectError";
		}
		
		//check if error
		if(msgErrorService.admCheckUpdateUserPasswordError(user)){
			return "redirect:/admin/user/update/" + String.valueOf(user.getId());
		}
		
		//get encrypted and current password
		String encrypted_password = SecurityConfig.getEncryption(user.getPassword());
		String current_password = userService.pickUpUser(user.getId()).getPassword();
		
		//check if new password different from current one
		if(msgErrorService.admCheckIsEqualPasswordError(encrypted_password, current_password)) {
			return "redirect:/admin/user/update/" + String.valueOf(user.getId());
		}
		
		//set user
		user = userService.pickUpUser(user.getId());
		user.setPassword(encrypted_password);
		
		//save user
		userService.saveUser(user);
		
		//reset error context
		msgErrorService.setActionError("", "");
		
		return "redirect:/admin/users";
    }

	@GetMapping("/admin/user/delete/{listId}")
    public String adminuserdelete(@PathVariable("listId") String listId, Model model) 
    		throws IOException, ParseException, java.text.ParseException, NoSuchAlgorithmException {
		
		//check connection
		if(!contextService.admCheckConnection()) {
			return "redirect:/admin/adminconnectError";
		}
		
		//check if listId correct
		if(msgErrorService.admCheckDeleteUserError(listId, contextService.getSessionContext().getUserId())){
			return "redirect:/admin/urlError/delete/" + listId;
		}
		
		//add map of users and ids in page
		model.addAttribute("map", userService.mapUsers(listId));
		model.addAttribute("object", new StringObject(listId));
		
		return "admin/admdelete";
    }
    
