	/** login **/
	@GetMapping("/admin/login")
    public String admlogin(User user, BindingResult result, Model model) throws IOException, ParseException, java.text.ParseException {
		
		//get user from map
		HashMap<String, String> map = msgErrorService.getMapUser();
		user.setAttr(map.get("username"), map.get("password"));
		
		//get error message
		String error = msgErrorService.getErrorMsg();
				
		//add user and error in page
		model.addAttribute("user", user);
		model.addAttribute("error", error);
		
		//reset user's errorContext
		msgErrorService.setUserError("", "", "", "", "");
		
		return "admin/admlogin";
    }
	
	@PostMapping("/admin/connect")
    public String admConnect(User user, BindingResult result, Model model) 
    		throws IOException, ParseException, java.text.ParseException, NoSuchAlgorithmException {
		
		//check if error
		if(msgErrorService.admCheckLoginError(user)) {
			return "redirect:/admin/login";
		}
				
		//get user's id and session's code
		int idUser = userService.pickUpUser(user.getUsername()).getId();
		String code = RequestContextHolder.currentRequestAttributes().getSessionId();
				
		//set beans userContext and sessionContext
		contextService.setUserContext(idUser);
		contextService.setSessionContext(idUser, user.getUsername(), code, "administrator");
				
		//reset message's errorContext
		msgErrorService.setUserError("", "", "", "", "");
		
		return "redirect:/admin";
    }

	
	@GetMapping("/admin/logout")
    public String adminadduser(Model model) throws IOException, ParseException, java.text.ParseException {
		
		//reset session
		contextService.setSessionContext(0, "", "");
		contextService.getSessionContext().setRole("");
				
		return "redirect:/admin/login";
    }
	
