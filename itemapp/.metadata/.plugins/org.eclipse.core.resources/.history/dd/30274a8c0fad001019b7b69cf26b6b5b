	/** init **/
	@GetMapping("/admin")
    public String admin(Model model) throws IOException, ParseException, java.text.ParseException, NoSuchAlgorithmException {
		
		//if connected login
		if(!contextService.admCheckConnection()) {
			return "redirect:/admin/login";
		}
		
		//if no admin redirect to create first admin
		if(!userService.hasAdmin()) {
			return "redirect:/admin/first";
		}
		
		//else redirect user table
		return "redirect:/admin/menu";

    }
	
