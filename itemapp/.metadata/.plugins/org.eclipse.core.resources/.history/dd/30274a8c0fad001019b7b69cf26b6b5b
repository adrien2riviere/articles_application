	/** users **/
	@GetMapping("/admin/users")
    public String adminconnect(Model model) throws IOException, ParseException, java.text.ParseException {
		
		//check if connection
		if(!contextService.admCheckConnection()) {
			return "redirect:/admin/connectError";
		}
		
		//get users from map
		HashMap<String, String> map = msgErrorService.getMapAction();
		Iterable<User> users = userService.getUsers();
		
		//get userId of session and action
		int userId = contextService.getSessionContext().getUserId();
		Action action = new Action(map.get("operation"), "");
		
		//get error message
		String error = msgErrorService.getMsgErrorContext().getErrorMsg();
		
		//set models in page
		model.addAttribute("users", users);
		model.addAttribute("userId", userId);
		model.addAttribute("error", error);
		model.addAttribute("action", action);
		
		//reset error message
		msgErrorService.setUserError("", "", "", "", "", "", "", "");
		msgErrorService.setActionError("", "");
		
		return "admin/adminusers";
    }
	
	@PostMapping("/admin/user/action")
    public String adminaction(Action action, BindingResult result, Model model) 
    		throws IOException, ParseException, java.text.ParseException {
		
		//check connection
		if(!contextService.admCheckConnection()) {
			return "redirect:/admin/connectError";
		}
		
		//check action
		if(msgErrorService.admCheckAction(action, contextService.getSessionContext().getUserId())) {
			return "redirect:/admin/users";
		}
		
		//return according to operation
		switch(action.getOperation()) {
			case "addition":
			    return "redirect:/admin/user/add";
			case "update":
			    return "redirect:/admin/user/update/" + action.getListIds();
			case "deletion":
			    return "redirect:/admin/user/delete/" + action.getListIds();
			default:
			    return "redirect:/admin/users";
		}

	}
	
