	@GetMapping("/Item100/add")
    public String add(Model model) throws IOException, ParseException, IllegalArgumentException, IllegalAccessException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//create item
		Item item = new Item();
		item.setPrice("0");
		
		//get item context
		if(contextService.getItemContext().isUpdate()) {
			HashMap<String, String> map = msgErrorService.getMapModel();
			item.setAttr(map.get("colour"), map.get("size"), map.get("graphics"), map.get("price"));
			if(item.getPrice().isBlank()) {
				item.setPrice("0");
			}
		}
		
		//get error message
		String error = msgErrorService.getErrorMsg();
		
		//add item model and error in page
		model.addAttribute("item", item);
	 	model.addAttribute("error", error);
		
		//reset item context and error message
		contextService.getItemContext().setUpdate(false);
	 	msgErrorService.setModelError("", null);
		
        return "item100/add";
    }
	
	@PostMapping("/Item100/additem")
    public String addItem(Item item, BindingResult result, Model model) throws IOException, ParseException, 
    java.text.ParseException, NoSuchAlgorithmException, IllegalArgumentException, IllegalAccessException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
    	//set error and item context
    	msgErrorService.setMapModel(item.getAttrMap());
    	contextService.getItemContext().setUpdate(true);

		//check if errors
		if(msgErrorService.checkingModelError(item.getValues(), "item")) {
			return "redirect:/Item100/add";
		}
		
		//save item for have an id
        itemService.saveItem(item);
        
		//get reference for item from id
        String zeros = "000";
        String strId = String.valueOf(item.getId());
        String reference = zeros.substring(0, zeros.length() - strId.length()) + strId;
        
        //set item
        item.setReference(reference);
        item.getSizenumber(item.getSize());
        item.setDepartment(contextService.getUserContext().getDepartment());
        item.trim();
        
        //save item
        itemService.saveItem(item);
        
        //save operation and limit the number of saved operation
        operationService.saveThatOperation(item.getReference(), item.getValuesString(), "ADDITION");
        operationService.hasToDelete(contextService.getUserContext().getDepartment());
      	
      	//set itemContext
        contextService.getItemContext().setUpdate(false);
        contextService.setItemContext(item.getId(), item.getReference(), "addition", 0, true, true);
        
        //reset error context
        msgErrorService.setModelError("", item.getAttrMap());
   
        return "redirect:/Item100/board";
    }
	
	
	@GetMapping("/Item100/update/{id}")//add user later
    public String update(@PathVariable("id") int id, Model model) throws IOException, ParseException, 
    IllegalArgumentException, IllegalAccessException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//check if item from user
		if(!itemService.checkItemDepartment(id)) {
			return "redirect:/urlError/update/" + String.valueOf(id);
		}
		
		//get item
		Item item = itemService.pickUpItem(id);
		
		//set item belong error context
		if(contextService.getItemContext().isUpdate()) {
			HashMap<String, String> map = msgErrorService.getMapModel();
			item.setAttr(map.get("colour"), map.get("size"), map.get("graphics"), map.get("price"));
		}
		
		//get error message
		String error = msgErrorService.getErrorMsg();
		
		//add models in page
		model.addAttribute("item", item);
		model.addAttribute("error", error);
		
		//set item context
		contextService.getItemContext().setUpdate(false);
		
		//reset error message
		msgErrorService.setModelError("", item.getAttrMap());
		
		return "item100/update";
    }
	
