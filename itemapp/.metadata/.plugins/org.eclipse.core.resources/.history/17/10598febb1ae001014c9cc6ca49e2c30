	@PostMapping("/Item100/deleteitem")
    public String deleteitem(Item item, BindingResult result, Model model) 
    		throws IOException, ParseException, java.text.ParseException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//delete the item
		itemService.deleteItem(item.getId());
		
		//save operation and limit the number of saved operation
		operationService.saveThatOperation(item.getReference(), item.getValuesString(), "DELETION");
        operationService.hasToDelete(contextService.getUserContext().getDepartment());
        
        //set itemContext
        int row = contextService.getMapRow().get(item.getId());
		contextService.setItemContext(item.getId(), item.getReference(), "deletion", row, true, true);

        return "redirect:/Item100/board";
    }

	/** sorting **/
	@GetMapping("/Item100/sorting")
    public String sorting(Model model) throws IOException, ParseException, java.text.ParseException {
		
		//check if connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//get language
		String lang = contextService.getUserContext().getLangage();
		
		//get sorting from user context and  from error context
		String sortingUser = contextService.getUserContext().getSorting();
		String sortingErr = msgErrorService.getSorting();
		
		//if needed: translate sorting from user context
		if(!lang.equals("en")) {
			sortingUser = BundleItem100.translateToLang(sortingUser);
		}

		//get error message
		String error = msgErrorService.getErrorMsg();
		
		//set sorting object
		StringObject sortingObject = new StringObject();
		String sorting = "";
		if(error.isEmpty()) {
			sorting = sortingUser;
		}
		else {
			sorting = sortingErr;
		}
		sortingObject.setText(sorting);
		
		//add models in page
		model.addAttribute("sorting", sortingObject);
		model.addAttribute("error", error);
		
		//reset error message and sorting context
		msgErrorService.getMsgErrorContext().setErrorMsg("");
		msgErrorService.getMsgErrorContext().setSortingErr("");
		
		return "item100/sorting";
    }
	
	@PostMapping("/Item100/updatesorting")
    public String sorting(StringObject sorting, BindingResult result, Model model) throws IOException, ParseException {
		
		//check if connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//get sorting and error message
		String sortingOrder = sorting.getText();
		String errorMsg = msgErrorService.getSortingOrderMsg(sortingOrder);
		
		//redirect if error (error message not empty)	
		if(!errorMsg.isEmpty()) {
			msgErrorService.getMsgErrorContext().setSortingErr(sortingOrder);
			msgErrorService.setMsgErrorContext(errorMsg);
			return "redirect:/Item100/sorting";
		}
		
		//get user
		int idUser = contextService.getSessionContext().getUserId();
		User user = userService.pickUpUser(idUser);
		
		//set sorting in user
		String translation = BundleItem100.translateToEN(sortingOrder);
		user.setSorting(translation);
		
		//save user
		userService.saveUser(user);
		
		//set User context
		contextService.getUserContext().setSorting(translation);
		
		//set error message context
		msgErrorService.getMsgErrorContext().setSortingErr("");
		msgErrorService.setMsgErrorContext("");
		
		return "redirect:/Item100/sorting";
    }
    
