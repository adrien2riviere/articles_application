	/** init **/
	@GetMapping("/Item100/init")
    public String home(Model model) throws FileNotFoundException, IOException, NoSuchAlgorithmException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}

		//set recent of itemContext false and pageNumber of userContext to << 0 >>
		contextService.getItemContext().setRecent(false);
		contextService.getUserContext().setPage(0);
		
		return "redirect:/Item100/board";
		
    }
	
	/** transaction **/
	@GetMapping("/Item100/board")
    public String board(Model model) throws NoSuchElementException {
		
		//check if connected
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//check if recent operation
		if(!contextService.getRecent()) {
			contextService.getItemContext().setReference("");
		}
		
		//get url suffixe
		String suffixe = contextService.getUserContext().getDisplay();
		if(suffixe.equals("pagination")) {
			suffixe = "listBooks" + contextService.getsizeAndPage();
		}
		
		//set pageNumber of userContext
		contextService.getUserContext().setPage(0);
		
		return "redirect:/Item100/" + suffixe;
		
    }
	
	@GetMapping("/Item100/display/{option}")
    public String display(@PathVariable("option") String option, Model model) throws NoSuchElementException {
		
		//check if connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//check if recent operation
		if(!contextService.getRecent()) {
			contextService.getItemContext().setReference("");
		}

		//get url suffixe
		String suffixe = "";
		if(option.equals("scrollbar")) {
			suffixe = "scrollbar";
		}
		else if(option.equals("pagination")) {
			suffixe = "listBooks" + contextService.getsizeAndPage();
		}
		
		//set display option in user context
		contextService.getUserContext().setDisplay(option);
		
		//set display in user
		User user  = userService.pickUpUser(contextService.getSessionContext().getUserId());
		user.setDisplay(option);
		
		//save user
		userService.saveUser(user);
		
		return "redirect:/Item100/" +  suffixe;
		
    }
	
	@GetMapping("/Item100/scrollbar")
    public String scrollbar(Model model) throws IOException, ParseException, java.text.ParseException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//set sorting order in user context
		contextService.checkSetUserContextSorting();
		
		//get items and item context
		Iterable<Item> items = itemService.getItems();
		ItemContext line = contextService.getItemContext();
		
		//get user context and time(belong time zone)
		UserContext userContext = contextService.getUserContext();
		String time = contextService.getTime(userContext.getTimezone());
		
		//get row of scrollbar's position
		int row =  line.isToFind() ? contextService.getItemContext().getRow(): 0;
		
		//get error message
		String message = "";
		if(!line.getReference().isBlank()) { 
			message = BundleItem100.getAlertMessage(line, contextService.getUserContext().getTimezone());
		}
		
		//add item and item context in page
		model.addAttribute("items", items);
		model.addAttribute("line", line);
		
		//add user context and time (belong time zone)
		model.addAttribute("userContext", userContext);
		model.addAttribute("time", time);
		
		//add scroll bar row in page
		model.addAttribute("row", row);
		
		//add message in page
		model.addAttribute("message", message);

		//check if has to find page or scroll bar position
		//set toFind false and row 0 if not
		if(line.isToFind()) {
			contextService.setToFindFalse();
			contextService.setRowNull();
		};
		
		return "item100/scrollbar";
    }

	@RequestMapping(value = "/Item100/listBooks", method = RequestMethod.GET)
	public String listBooks(Model model, 
		     @RequestParam("page") Optional<Integer> page, 
		     @RequestParam("size") Optional<Integer> size) 
		    		 throws IOException, ParseException, java.text.ParseException {
		
		//check connection
		if(!contextService.checkConnection()) {
			return "redirect:/connectError";
		}
		
		//check and set sorting order
		contextService.checkSetUserContextSorting();
					
		//get page and size of page
		int defaultSize = contextService.getUserContext().getPageSize();
		int currentPage = page.orElse(1);
		int pageSize = size.orElse(defaultSize);
		
		//get page of items and number of pages
		Page<Item> bookPage = itemService.findPaginated(PageRequest.of(currentPage - 1, pageSize));
		int totalPages = bookPage.getTotalPages();
		
		//get last operation (after a transaction) and find if page calculation needed
		ItemContext line = contextService.getItemContext();
		boolean isToFind = contextService.getItemContext().isToFind();
		
		//get user context and time (belong time zone)
		UserContext userContext = contextService.getUserContext();
		String time = contextService.getTime(userContext.getTimezone());
		
		//set page number in user context
		contextService.getUserContext().setPage(currentPage);
			    
		//if items is empty: redirect
		if(bookPage.getContent().isEmpty() && currentPage > 1) {
			contextService.getUserContext().setPage(currentPage-1);
			String op = contextService.getItemContext().getOperation();
			if(op.equals("deletion")){
				int row = contextService.getItemContext().getRow();
			    contextService.getItemContext().setRow(row-1);
			}
		    return "redirect:/Item100/board";
		}
		
		//if page needed to be calculate: change pageNum in userContext and redirect
		if(isToFind) {
			int row = contextService.getItemContext().getRow();
			int pageNum = row%pageSize == 0 ? row/pageSize : row/pageSize + 1;
		    if(pageNum != currentPage) {
		    	contextService.getUserContext().setPage(pageNum);
		    	return "redirect:/Item100/board";
		    } 	
		}
			    
		//add page number and page of item in page
		model.addAttribute("page", currentPage);
		model.addAttribute("bookPage", bookPage);
		
		//add item context in page
		model.addAttribute("line", line);

		//add user context and time (belong time zone) in page
		model.addAttribute("userContext", userContext);
		model.addAttribute("time", time);
		
		//add page numbers button in page
		if (totalPages > 0) {
			List<Integer> pageNumbers = IntStream.rangeClosed(1, totalPages)
				.boxed()
				.collect(Collectors.toList());
			model.addAttribute("pageNumbers", pageNumbers);
		}
		
		//add alert  message in page
		if(!line.getReference().isBlank()) {
			String message = BundleItem100.getAlertMessage(line, contextService.getUserContext().getTimezone());
			model.addAttribute("message", message);
		}
		
		//set toFind of itemContext to false
		if(isToFind) {
			contextService.getItemContext().setToFind(false);
		};
			  			
	    return "item100/listBooks.html";
	}
	
