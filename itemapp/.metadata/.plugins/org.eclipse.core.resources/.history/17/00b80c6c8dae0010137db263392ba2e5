    public String admCheckDeleteUserError(String listId) throws NoSuchAlgorithmException {
    	
    	//init errorMsg variable
    	String errorMsg = "";
    	
    	//check for error
    	if(listId.isBlank()) {
    		errorMsg = "At least one user must be selected !";
    	}
    	
    	String[] ids = listId.split(",");
    	for(String id : ids) {
    		if(userService.getUser(Integer.parseInt(id)).isPresent()) {
    			errorMsg = "A user in selection doesn't exist !";
    		}
    	}
    	
    	
    	if(listId.isBlank()) {
    		errorMsg = "At least one user must be selected !";
    	}
    	
    	int userId = contextService.getSessionContext().getUserId();
    	if(listId.contains(String.valueOf(userId))) {
    		errorMsg = "The user used for connection cannot be deleted !";
    	}
    	
    	
    	return errorMsg;
    }
    
