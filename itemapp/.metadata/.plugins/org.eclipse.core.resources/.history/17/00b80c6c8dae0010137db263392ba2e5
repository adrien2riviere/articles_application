	//check login error
    public String checkLoginError(User user) throws NoSuchAlgorithmException {
   
    	//init errorMsg variable
    	String errorMsg = "";
    	
    	//check for error
    	if(user.getUsername().isEmpty()) {
    		errorMsg = "The username field is required !";
    	}
    	else if(user.getUsername().isBlank()) {
    		errorMsg = "The username is not blank !";
    	}
    	else if(!userService.getUser(user.getUsername()).isPresent()) {
    		errorMsg = "That user doesn't exists !";
    	}
    	else if(!userService.pickUpUser(user.getUsername()).getRole().equals("user")) {
    		errorMsg = "That user is an administrator, not a simple user !";
    	}
    	else if(user.getPassword().isEmpty()) {
    		errorMsg = "The password field is required !";
    	}
    	else if(user.getPassword().isBlank()) {
    		errorMsg = "The password is not blank !";
    	}
    	else if(!userService.checkUserPass(user)){
    		errorMsg = "The password is not correct !";
    	}
    	
    	return errorMsg;			
	}
    
