	/**SessionContext**/
	
	//get session context
	public SessionContext getSessionContext() {
		return context.getBean(SessionContext.class);
	}
	
	//set session context
	public void setSessionContext(int userId, String username, String code) {
		getSessionContext().setAttr(userId, username, code);
	}
	
	//set session context
	public void setSessionContext(int userId, String username, String code, String role) {
		getSessionContext().setAttr(userId, username, role, code);
	}

	//check connection (with session bean id and the id of the current session)
	public Boolean checkConnection()  {
		String session1 = context.getBean(SessionContext.class).getSessionId();
		String session2 = RequestContextHolder.currentRequestAttributes().getSessionId();
		String role = context.getBean(SessionContext.class).getRole();
		return session1.equals(session2) && role.equals("user");
	}
	
	public Boolean admCheckConnection()  {
		String session1 = context.getBean(SessionContext.class).getSessionId();
		String session2 = RequestContextHolder.currentRequestAttributes().getSessionId();
		String role = context.getBean(SessionContext.class).getRole();
		return session1.equals(session2) && role.equals("administrator");
	}
	
	
	/**UserContext**/
	
	//get user context
	public UserContext getUserContext() {
		return context.getBean(UserContext.class);
	}

	//set user context by user's id
	public void setUserContext(int idUser) {

		//get user
		User user = userService.pickUpUser(idUser);
		
		//get user's properties
		String lang = user.getLangage();
		String timezone = user.getTimezone();
		String display = user.getDisplay();
		String sorting = user.getSorting();
		String department = user.getDepartment();
		
		//set size of page (numbers of row)
		int pageSize = 10;
		
		//set properties of user
		setUserContext(lang, timezone, display, sorting, pageSize, department);

	}
	
	//set user context
	public void setUserContext(String lang, String timezone, String display, String sorting, int pageSize) {
		getUserContext().setAttr(lang, timezone, display, sorting, pageSize);
	}
	
	//set user context
	public void setUserContext(String lang, String timezone, String display, String sorting, int pageSize, String department) {
		getUserContext().setAttr(lang, timezone, display, sorting, pageSize, department);
	}
	
	//set row in user context to 0
    public void setRowNull() {
		context.getBean(UserContext.class).setRow(0);
	}
	
	//check if sorting is valid
	public void checkSetUserContextSorting() throws FileNotFoundException, IOException {
		if(!context.getBean(UserContext.class).checkSorting()) {
			getUserContext().setSorting("item no");
		}
	}
	
    //get page and size of page from user context
    public String getsizeAndPage() {
    	return getUserContext().getSizeAndPage();
	}
    
