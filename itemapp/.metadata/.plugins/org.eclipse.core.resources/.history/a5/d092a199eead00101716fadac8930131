
var selectRole = document.getElementById("role");
selectRole.onchange = logSelection;

function logSelection() {
	let value = selectRole.value;
	if(value == "user") {
		document.getElementById("langage").disabled = false;
		document.getElementById("langage").required = true;
	}
	else {
		document.getElementById("langage").disabled = true;
		document.getElementById("langage").required = false;
	}
}
