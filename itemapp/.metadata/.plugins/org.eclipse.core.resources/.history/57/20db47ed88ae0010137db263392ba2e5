
var selectRole = document.getElementById("role");
selectRole.onchange = logSelection;

if(selectRole.value == "user"){
	document.getElementById("langage").disabled = false;
	document.getElementById("langage").required = true;
	document.getElementById("timezone").disabled = false;
	document.getElementById("timezone").required = true;
	document.getElementById("display").disabled = false;
	document.getElementById("display").required = true;
}

function logSelection() {
	let value = selectRole.value;
	if(value == "user") {
		document.getElementById("langage").disabled = false;
		document.getElementById("langage").required = true;
		document.getElementById("timezone").disabled = false;
		document.getElementById("timezone").required = true;
		document.getElementById("display").disabled = false;
		document.getElementById("display").required = true;
	}
	else {
		document.getElementById("langage").disabled = true;
		document.getElementById("langage").required = false;
		document.getElementById("langage").value = false;
		document.getElementById("timezone").disabled = true;
		document.getElementById("timezone").required = false;
		document.getElementById("display").disabled = true;
		document.getElementById("display").required = false;
	}
}
