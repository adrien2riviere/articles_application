body {
  	background-color: lightyellow;
	padding-inline-start:1em;
	padding-inline-end:1em;
}

h2 {
	font-family:Arial;
	font-size: 1.2em;
	display:inline;
	margin-right:1em;
}

table {
	margin-top:1em;
	background-color:white;
	border-style: solid;
  	border-width: thin;
  	border-collapse: collapse;
  	width: 100%;
  	cursor: default;/*avoir fleche sourie quand survole texte*/
  	table-layout: fixed;
  	margin-bottom:1em;
}

thead{
	background-color:#e0e0e0;
	display: block;
    overflow-y: scroll;
    border-bottom-style: solid;
  	border-width: thin;
  	border-color:black;
}

tbody {
    display: block;
    width: 100%;
    overflow-y: scroll;
    height: 24.2em;
}

div.entete {
	width:65%;
}

th {
	font-size: 1em;
  	text-align: center;
  	overflow:hidden;
  	text-overflow: ellipsis;
  	white-space:pre;
  	width: 20%;
  	font-family:Arial;
  	padding-top:0.4em;
  	padding-bottom:0.4em;
}

th.row_table, td.row_table{
	width: 10%;
	text-align:center;
}

tr {
    display: block;
	display: flex;
	border-bottom:solid;
	border-width:thin;
    border-color:lightgrey;
}

tr:nth-child(even) {
  background-color: #f2f2f2;
}

tr.addition {
	background-color: rgb(160, 230, 210);
}

tr.update {
	background-color: rgb(180, 200, 240);
	
}

td {
	text-align:center;
	padding-top:0.4em;
	padding-bottom:0.4em;
	width: 20%;
	font-family:Calibri;
}

img {
	height:0.7em;
	width:0.7em;
