/** message after operation **/

div.message {
	background-color:white;
	width: 65%;
}

div.message > span {
	
	padding-left:1em;
	font-size:0.8em;
	line-height: 3em;
}

div.message > a {
	font-size:0.8em;
	line-height: 3em;
	margin-right:2em;
	float:right;
}


/** context menu **/
.dropbtn {
  border: none;
  cursor: pointer;
}


.dropdown {
	position: static;
}


.dropdown-content {
	border:solid;
	border-width:thin;
	border-color:grey;
 	display: none;
 	position: absolute;
	background-color: #f1f1f1;
	box-shadow: 0em 4em 8em 0em rgba(0,0,0,0.2);
	text-align:left;
	width:6em;
	z-index:10;
	margin-left:-0.5em;
}

.dropdown-content a {
  	color: black;
  	padding:0.5em;
  	text-decoration:none;
  	display: block;
 	padding-left:1em;
}

.dropdown a:hover {
	background-color: #ddd;
}

.show {
	display: block;
}
