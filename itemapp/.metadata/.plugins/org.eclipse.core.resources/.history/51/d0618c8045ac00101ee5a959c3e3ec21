	//get items according to sorting order
    public Iterable<Item> getItems() throws IOException, ParseException {
    	
    	//init variables
    	int counter = 0;
    	//int userId = 0;
    	String department;
    	String sorting = "";
    	String reference = "";
    	String[] list = null;
    	
    	//set MapRow empty
    	context.getBean(MapRowContext.class).setMapRow(new HashMap<Integer, Integer>());
    	
    	//get list from sorting
    	sorting = context.getBean(UserContext.class).getSorting();
    	sorting = sorting.replaceFirst("item no", "reference");
    	sorting = sorting.replaceFirst("size", "sizenumber");
    	list = sorting.split(", ");
    	
    	//create sort criteria and get userId
    	Sort sort = Sort.by(Sort.Direction.ASC, list);
    	
    	//get required items
    	department = context.getBean(UserContext.class).getDepartment();
    	Iterable<Item> items = itemRepository.findAllByDepartment(department, sort);
    	
    	//get reference of item context
    	reference = context.getBean(ItemContext.class).getReference();
    	
    	//loop for complete items (row and size number)
    	//if needed set item context
    	for(Item item : items) {
    		counter += 1;
    		context.getBean(MapRowContext.class).addMapRow(item.getId(), counter);//to delete ?
    		item.setTable_row(counter);
    		item.setSize(BundleMessage.getSize(item.getSize()));
    		if(reference.equals(item.getReference())) {
    			context.getBean(ItemContext.class).setRow(counter);
    		}	
    	}
    	
        return items;
    }
    
    public Page<Item> findPaginated(Pageable pageable) throws IOException, ParseException {
    	
    	//page variables
        int pageSize = pageable.getPageSize();
        int currentPage = pageable.getPageNumber();
        int startItem = currentPage * pageSize;
        
        //list of items and sublist
        List<Item> items = getItemsList();
        List<Item> list;
        
        //complete sublist
        if (items.size() < startItem) {
            list = Collections.emptyList();
        } else {
            int toIndex = Math.min(startItem + pageSize, items.size());
            list = items.subList(startItem, toIndex);
        }

        //making page
        Page<Item> bookPage
          = new PageImpl<Item>(list, PageRequest.of(currentPage, pageSize), items.size());

        return bookPage;
    }
	
    //get items for making page
	public List<Item> getItemsList() throws IOException, ParseException {
    	
		//make list with iterable collection
    	Iterable<Item> items = getItems();
    	List<Item> list = StreamSupport 
                .stream(items.spliterator(), false) 
                .collect(Collectors.toList());
    	
        return list;
    }

