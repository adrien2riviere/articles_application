    public boolean admCheckDeleteUserError(String listId, int userid) throws NoSuchAlgorithmException {
    	
    	boolean isError = false;
    	
    	//check for error
    	isError = listId.isBlank();
    		
    	String[] ids = listId.split(",");
    	
    	
    	for(String id : ids) {
    		boolean isPresent = userService.getUser(Integer.parseInt(id)).isPresent();
    		boolean isSessionId = Integer.parseInt(id) == userid;
    		if(!isPresent || isSessionId) {
    			isError = true;
    			break;
    		}
    	}
    	
    	return isError;
    }
    
